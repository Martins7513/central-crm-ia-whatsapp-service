# ============================================================
# Central CRM IA — Microsserviço WhatsApp (Baileys)
# Variáveis de ambiente — configure estas no painel do Railway
# (Settings > Variables), NÃO em um arquivo .env commitado.
# ============================================================

# Chave secreta que protege os endpoints deste serviço.
# Gere um valor aleatório forte, por exemplo com:
#   openssl rand -hex 32
# Esta mesma chave será usada no painel do CRM (Configurações da conexão).
SERVICE_SECRET=defina-uma-chave-secreta-forte-aqui

# URL pública do seu Central CRM IA já publicado (sem barra no final).
# Exemplo: https://03a06473-ae62-4dba-a13a-786da69d894f.vip.gensparksite.com
CRM_BASE_URL=https://SEU-CRM-PUBLICADO.vip.gensparksite.com

# Porta HTTP (o Railway define automaticamente via variável PORT, pode deixar como está)
PORT=3000

# Diretório onde as sessões autenticadas do WhatsApp são salvas.
# No Dockerfile já aponta para /app/sessions — monte um Volume no Railway
# neste caminho para não perder a sessão a cada deploy.
SESSIONS_DIR=/app/sessions
